{
  "name": "poc/analysis-chatbot",
  "type": "project",
  "license": "proprietary",
  "require": {"php": "8.5.12", "laravel/framework": "13.39.0"},
  "require-dev": {"mockery/mockery": "^1.6", "phpunit/phpunit": "^12.5"},
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": "@php vendor/bin/phpunit"},
  "config": {"optimize-autoloader": true, "sort-packages": true, "allow-plugins": {}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
