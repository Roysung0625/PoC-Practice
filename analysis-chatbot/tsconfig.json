{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "paths": {
      "vue": [
        "./node_modules/vue"
      ],
      "vitest": [
        "./node_modules/vitest"
      ]
    }
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.vue",
    "vite.config.ts",
    "vitest.config.ts",
    "../product-registration/frontend/**/*.ts",
    "../product-registration/frontend/**/*.vue"
  ]
}
