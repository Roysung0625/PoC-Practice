# 실제 파일: 프로젝트 루트 .local/app.env (Git 제외)
POC_DB_DSN='host=127.0.0.1 port=5432 dbname=poc_idempiere user=poc_idempiere_reader password=CHANGE_ME'
# 설치 시 해당 장비의 절대경로를 기록한다. 아래 상대경로 예시는 프로젝트 루트에서 실행할 때만 유효하다.
POC_CATALOG_PATH='.local/datasets/idempiere/catalog.json'
POC_INTERNAL_TOKEN='CHANGE_ME_TO_RANDOM_TOKEN'
POC_CHATBOT_PROFILE='poc-chatbot'
POC_WORKER_PROFILE='poc-worker'
POC_AWS_ACCOUNT_ID='ACCOUNT_ID'
POC_AGENT_ARN=''
POC_QUEUE_URL=''
POC_RESULT_TABLE=''
